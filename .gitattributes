# Normalize line endings: store LF in Git and check out LF on every OS.
# Prevents "LF will be replaced by CRLF" noise and keeps files identical inside Linux containers.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary files are never modified.
*.png binary
*.jpg binary
*.db binary
