# SmartFlow environment template.
# Copy this file to ".env" and replace the placeholder values.
# Never commit the real ".env" file.

# Shared secret used by n8n when calling the SmartFlow API (X-Api-Key header).
# Store the same value in the n8n credential "SmartFlow API key".
SMARTFLOW_API_KEY=replace-with-a-long-random-string

# Encrypts credentials stored by n8n.
N8N_ENCRYPTION_KEY=replace-with-a-long-random-string

# Local LLM used by the n8n workflow (see eval/README.md for how it was chosen).
# The workflow reaches Ollama at http://ollama:11434 inside the Docker network.
# After the first start, download the model once:
#   docker compose exec ollama ollama pull llama3.2:3b
OLLAMA_MODEL=llama3.2:3b

# Claude API (planned optional provider, not used by the workflow yet).
ANTHROPIC_API_KEY=
